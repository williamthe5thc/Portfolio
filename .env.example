# Copy to .env.production (and add the same keys to .env.staging) before
# building. Vite reads VITE_* variables only at build time, so a build made
# without them ships without them. Unlike .env, neither file is git-ignored.

# EmailJS (https://dashboard.emailjs.com). Without all three, the contact form
# cannot send and instead opens the visitor's own email app with the message
# filled in. These values end up in the public JavaScript bundle by design;
# restrict the allowed origins in the EmailJS dashboard instead of keeping them
# secret.
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Google Analytics 4 measurement ID, read by src/hooks/useAnalytics.ts.
# index.html and GoogleAnalytics.tsx currently hard-code the production ID.
VITE_GA_TRACKING_ID=
