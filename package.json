{
  "name": "william-charles-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:staging": "vite --mode staging",
    "build": "vite build",
    "build:staging": "vite build --mode staging",
    "preview": "vite preview",
    "preview:staging": "vite preview --mode staging",
    "deploy": "npm run build:staging && gh-pages -d dist -b gh-pages --repo https://github.com/williamthe5thc/Portfolio-Staging.git",
    "deploy:production": "npm run build && gh-pages -d dist -b gh-pages --repo https://github.com/williamthe5thc/Portfolio.git",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "test:staged": "vitest related $(git diff --staged --name-only)",
    "test:e2e": "start-server-and-test dev http://localhost:3000 cy:run",
    "test:e2e:dev": "start-server-and-test dev http://localhost:3000 cy:open",
    "test:visual": "npm run chromatic",
    "test:performance": "vitest run tests/performance",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "chromatic": "chromatic --exit-zero-on-changes",
    "lighthouse": "lhci autorun",
    "analyze": "vite-bundle-analyzer",
    "monitor": "web-vitals-reporter",
    "prepare": "husky install"
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@types/react-helmet-async": "^1.0.1",
    "framer-motion": "^11.11.11",
    "intersection-observer": "^0.12.2",
    "lucide-react": "^0.323.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^6.22.0",
    "react-scroll": "^1.9.0",
    "web-vitals": "^3.5.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.40.1",
    "@storybook/addon-a11y": "^7.6.6",
    "@storybook/addon-essentials": "^7.6.6",
    "@storybook/addon-interactions": "^7.6.6",
    "@storybook/addon-links": "^7.6.6",
    "@storybook/addon-viewport": "^7.6.6",
    "@storybook/blocks": "^7.6.6",
    "@storybook/react": "^7.6.6",
    "@storybook/react-vite": "^7.6.6",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/cypress": "^10.0.1",
    "@testing-library/dom": "^9.3.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@types/react-helmet": "^6.1.11",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^1.6.0",
    "@vitest/ui": "^1.6.0",
    "autoprefixer": "^10.4.17",
    "chromatic": "^10.1.0",
    "cypress": "^13.6.1",
    "eslint": "^8.55.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-testing-library": "^6.2.0",
    "gh-pages": "^6.1.1",
    "happy-dom": "^15.11.4",
    "husky": "^9.0.11",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.33",
    "postcss-nested": "^6.0.1",
    "prettier": "^3.2.4",
    "rollup-plugin-visualizer": "^5.12.0",
    "start-server-and-test": "^2.0.3",
    "storybook": "^7.6.6",
    "storybook-addon-performance": "^0.17.1",
    "storybook-dark-mode": "^3.0.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.0.0",
    "vite": "^5.0.8",
    "vite-bundle-analyzer": "^0.8.1",
    "vitest": "^1.6.0"
  },
  "resolutions": {
    "@vitejs/plugin-react": "^4.2.1",
    "vite": "^5.0.8"
  }
}
